# Aline-Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Aline-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=libdazzle
pkgver=3.44.0
pkgrel=0
pkgdesc="Library to delight your users with fancy features"
url="https://gitlab.gnome.org/GNOME/libdazzle"
arch="all"
license="GPL-3.0-or-later"
depends="gtk3 libintl"
depends_dev="gtk3-dev"
makedepends="$depends_dev vala gobject-introspection-dev meson"
subpackages="$pkgname-dev $pkgname-lang"
source="https://download.gnome.org/sources/libdazzle/${pkgver%.*}/libdazzle-$pkgver.tar.xz
    "

build() {
    abuild-meson \
        -Denable_gtk_doc=false \
        . output
    meson compile -C output
}

check() {
    meson test --print-errorlogs -C output || true
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
eff3f65cbfd4f780afb4bda6137e8d4f1ee2cd0ab21288d07315415944ced1aa2d7ef89c2b7ebb373ac4c46b91d341bed063e9c7d1c21fa083514c8c3c9c518f  libdazzle-3.44.0.tar.xz
"
